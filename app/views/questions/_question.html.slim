tr
  td = question.name
  td.text-center = question.absolute ? t('yes') : t('no')
  td.text-center
    .btn-group.btn-group-sm role="group"
      = link_to t('edit'), edit_survey_question_path(@survey, question), class: "btn btn-outline-warning"
      = link_to t('delete'), survey_question_path(@survey, question),
              data: { turbo_method: :delete, turbo_confirm: t('confirm') },
              class: "btn btn-outline-danger"
